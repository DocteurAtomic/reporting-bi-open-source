# Copied to .env by ./setup/install.sh, which fills the three passwords with random values.
# .env is ignored by git: never commit it. A variable set in the real environment wins.

# Password of the postgres superuser, asked only for a connection through the network.
# psql inside the container does not ask for it.
POSTGRES_PASSWORD=

# Password of the role metabase, owner of the application database of Metabase.
MB_DB_PASS=

# Password of the role lecture_bi, which reads pachadataformation (connect, usage, select).
# You type it in Metabase when you connect the database (module 1); SQLPage uses it too.
LECTURE_BI_PASSWORD=

# API key of Metabase, read by ./setup/check.sh. Written by ./setup/api-key.sh (module 1).
MB_API_KEY=

# Key of the AI provider of Metabot (module 9). Leave it empty if you do not follow module 9.
# After a change: docker compose up -d metabase
MB_LLM_OPENROUTER_API_KEY=

# Host ports, published on 127.0.0.1 only. Change them before the first start if another
# program already uses them.
PGPORT=5433
MBPORT=3000
SQLPAGEPORT=8080

# Tag of the PostgreSQL image. 18 follows the minor releases (docker compose pull);
# set an exact version such as 18.6 to freeze the lab.
PG_TAG=18

# Prefix of the container names. Change it only to run a second lab next to this one.
LAB_CONTAINER=bicourse
