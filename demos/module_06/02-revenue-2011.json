{
  "name": "Chiffre d'affaires HT de 2011",
  "display": "scalar",
  "visualization_settings": {},
  "dataset_query": {
    "database": "@database",
    "type": "query",
    "query": {
      "source-table": "@card:Factures",
      "aggregation": [["metric", "@metric:Chiffre d'affaires HT"]],
      "filter": ["between", ["field", "datefacture", {"base-type": "type/Date"}], "2011-01-01", "2011-12-31"]
    }
  }
}
