{
  "name": "Sessions par année, années manquantes à zéro",
  "description": "Copie de « Sessions par année » en ligne, les valeurs manquantes remplacées par zéro (clip 4.2).",
  "display": "line",
  "visualization_settings": {"series_settings": {"count": {"line.missing": "zero"}}},
  "dataset_query": {
    "database": "@database",
    "type": "query",
    "query": {
      "source-table": "@stage.session",
      "aggregation": [["count"]],
      "breakout": [["field", "@stage.session.datedebut", {"temporal-unit": "year"}]]
    }
  }
}
