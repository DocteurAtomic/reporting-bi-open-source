{
  "name": "Factures de 2011 par mois, nombre et montant",
  "description": "Le double axe : le nombre de factures et leur montant hors taxes par mois de 2011, chacun sur son axe (clip 4.4).",
  "display": "line",
  "visualization_settings": {},
  "dataset_query": {
    "database": "@database",
    "type": "query",
    "query": {
      "source-table": "@inscription.facture",
      "filter": ["between", ["field", "@inscription.facture.datefacture", null], "2011-01-01", "2011-12-31"],
      "aggregation": [["count"], ["sum", ["field", "@inscription.facture.montantht", null]]],
      "breakout": [["field", "@inscription.facture.datefacture", {"temporal-unit": "month"}]]
    }
  }
}
