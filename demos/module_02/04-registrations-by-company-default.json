{
  "name": "Inscriptions par société, jointures par défaut",
  "display": "table",
  "visualization_settings": {},
  "dataset_query": {
    "database": "@database",
    "type": "query",
    "query": {
      "source-table": "@inscription.inscription",
      "joins": [
        {"alias": "Contact", "source-table": "@contact.contact", "strategy": "left-join", "fields": "none",
         "condition": ["=", ["field", "@inscription.inscription.contactid", null],
                            ["field", "@contact.contact.contactid", {"join-alias": "Contact"}]]},
        {"alias": "Societe", "source-table": "@contact.societe", "strategy": "left-join", "fields": "none",
         "condition": ["=", ["field", "@contact.contact.societeid", {"join-alias": "Contact"}],
                            ["field", "@contact.societe.societeid", {"join-alias": "Societe"}]]}
      ],
      "aggregation": [["count"]],
      "breakout": [["field", "@contact.societe.nom", {"join-alias": "Societe"}]],
      "order-by": [["desc", ["aggregation", 0]]]
    }
  }
}
